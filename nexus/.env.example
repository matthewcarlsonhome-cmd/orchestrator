# =============================================================================
# NEXUS CONFIGURATION
# =============================================================================
# Copy this file to .env and configure for your setup
# Most settings have sensible defaults for local development

# =============================================================================
# VECTOR DATABASE (Choose ONE)
# =============================================================================
# Options: chromadb (local, free), pinecone (cloud, scalable)
NEXUS_VECTOR_DB=chromadb

# For ChromaDB (local - no API key needed):
# Data stored in: ~/.nexus/chroma/

# For Pinecone (cloud):
# NEXUS_VECTOR_DB=pinecone
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX=nexus
# PINECONE_ENVIRONMENT=us-east-1

# =============================================================================
# EMBEDDING PROVIDER (Choose ONE)
# =============================================================================
# Options: local (free, private), openai (quality), voyage (best retrieval)
NEXUS_EMBEDDING_PROVIDER=local

# For Local embeddings (free, runs on your machine):
# Uses sentence-transformers, ~400MB model download first run
NEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# For OpenAI embeddings:
# NEXUS_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# NEXUS_EMBEDDING_MODEL=text-embedding-3-small

# For Voyage AI embeddings (best for retrieval):
# NEXUS_EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=your-voyage-api-key
# NEXUS_EMBEDDING_MODEL=voyage-2

# =============================================================================
# LLM PROVIDER (Choose ONE)
# =============================================================================
# Options: claude (Anthropic), openai (GPT)
NEXUS_LLM_PROVIDER=claude

# For Claude (recommended):
ANTHROPIC_API_KEY=your-anthropic-api-key
NEXUS_LLM_MODEL=claude-sonnet-4-20250514

# For OpenAI:
# NEXUS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# NEXUS_LLM_MODEL=gpt-4o

# =============================================================================
# METADATA DATABASE
# =============================================================================
# Options: sqlite (local file), postgresql (production)
NEXUS_METADATA_DB=sqlite

# For SQLite (local, default):
# Stored at: ~/.nexus/nexus.db

# For PostgreSQL:
# NEXUS_METADATA_DB=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# =============================================================================
# SERVER SETTINGS
# =============================================================================
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8430
NEXUS_DEBUG=false

# =============================================================================
# DATA DIRECTORIES
# =============================================================================
# Where Nexus stores all data (default: ~/.nexus)
# NEXUS_DATA_DIR=/path/to/custom/data/dir

# =============================================================================
# AGENT SETTINGS
# =============================================================================
# Enable autonomous background agents
NEXUS_AGENTS_ENABLED=true

# How often agents check for scheduled runs (seconds)
NEXUS_AGENT_CHECK_INTERVAL=60

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Chunk size for document splitting (tokens)
NEXUS_CHUNK_SIZE=500

# Overlap between chunks (tokens)
NEXUS_CHUNK_OVERLAP=50

# Number of results to return for search
NEXUS_DEFAULT_SEARCH_LIMIT=10

# Minimum similarity score to include in results (0.0 - 1.0)
NEXUS_MIN_SIMILARITY=0.5
